DB_HOST=127.0.0.1
DB_PORT=3306

# Pinned explicitly so the database is never chosen by discovery.
# config/database.php can otherwise fall back to whichever of `svts` /
# `student_violation_system` it finds, and if both ever exist on one
# machine a registration can land in one while the search that follows
# reads the other -- the reported "registered student disappears" and
# "student exists but search says not existing". Naming it removes the
# guess entirely.
DB_NAME=student_violation_system
